<!-- THANK YOU PAGE: CLEAN, SIMPLE & HIGH-CONVERTING -->
<section class="min-h-[85vh] flex items-center justify-center bg-cream px-4 sm:px-6 py-16 bg-grid">
  <div class="max-w-xl w-full mx-auto text-center">

    <!-- Success Card -->
    <div class="bg-white rounded-[32px] p-8 sm:p-12 border border-black/10 shadow-xl relative overflow-hidden">
      
      <!-- Top Subtle Green Accent Line -->
      <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-primary to-emerald-400"></div>

      <!-- Animated Green Success Checkmark -->
      <div class="w-20 h-20 sm:w-24 sm:h-24 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-6 border-2 border-primary/20 shadow-inner">
        <div class="w-14 h-14 sm:w-16 sm:h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl sm:text-3xl shadow-lg shadow-primary/30">
          <i class="fas fa-check"></i>
        </div>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-dark mb-4">
        Thank You!
      </h1>
      <h2 class="text-lg sm:text-xl font-bold text-primary mb-4">
        Your Message Has Been Received.
      </h2>

      <!-- Description -->
      <p class="text-dark/70 text-sm sm:text-base leading-relaxed mb-8">
        We have saved your details. Our founder <strong class="text-dark">Neel Shah</strong> and the WholeUp growth team will review your requirement and get in touch with you within <strong class="text-dark">15 to 30 minutes</strong>.
      </p>

      <!-- Instant WhatsApp Action Box -->
      <div class="bg-emerald-50/70 border border-emerald-500/20 rounded-2xl p-5 mb-6 text-center">
        <p class="text-xs sm:text-sm font-bold text-dark/80 mb-3 flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
          Need an immediate response? Connect directly:
        </p>
        <a id="wa-thankyou-btn" href="https://api.whatsapp.com/send?phone=919426846035&text=Hi%20Neel,%20I%20just%20submitted%20my%20inquiry%20on%20WholeUp%20and%20want%20to%20discuss%20my%20growth%20strategy." target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-[#25D366] hover:bg-green-600 text-white font-black uppercase tracking-wider py-3.5 px-6 rounded-xl shadow-lg shadow-[#25D366]/20 hover:shadow-xl transition transform hover:-translate-y-0.5 text-sm sm:text-base w-full cursor-pointer">
          <i class="fab fa-whatsapp text-xl"></i>
          <span>Chat With Us on WhatsApp</span>
        </a>
      </div>

      <!-- Secondary Action: Back to Home -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a href="/" class="inline-flex items-center justify-center gap-2 text-dark/70 hover:text-primary text-xs sm:text-sm font-bold uppercase tracking-wider py-2.5 px-5 rounded-lg border border-black/10 hover:border-primary/30 transition">
          <i class="fas fa-arrow-left text-xs"></i>
          <span>Back to Homepage</span>
        </a>
        <a href="tel:+919426846035" class="inline-flex items-center justify-center gap-2 text-dark/70 hover:text-primary text-xs sm:text-sm font-bold uppercase tracking-wider py-2.5 px-5 rounded-lg border border-black/10 hover:border-primary/30 transition">
          <i class="fas fa-phone-alt text-xs text-primary"></i>
          <span>Call: +91 94268 46035</span>
        </a>
      </div>

    </div>

    <!-- Small Footer Note -->
    <p class="text-xs text-dark/40 font-medium mt-6">
      WholeUp Digital Marketing Agency &bull; Surat, Gujarat
    </p>

  </div>
</section>

<!-- SILENT TRACKING SCRIPTS IN BACKGROUND (META PIXEL & GOOGLE ADS) -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Dynamic WhatsApp prefill if query params are present
    try {
      var params = new URLSearchParams(window.location.search);
      var name = params.get('name');
      var service = params.get('service');
      var waBtn = document.getElementById('wa-thankyou-btn');
      if (waBtn && (name || service)) {
        var msg = 'Hi Neel, I (' + (name ? decodeURIComponent(name) : 'Client') + ') just submitted an inquiry on WholeUp for ' + (service ? decodeURIComponent(service) : 'Growth Marketing') + ' and want to discuss it.';
        waBtn.href = 'https://api.whatsapp.com/send?phone=919426846035&text=' + encodeURIComponent(msg);
      }
    } catch (e) {
      console.warn('URL param parse error:', e);
    }

    // 2. META PIXEL: Automatically records Lead event
    try {
      if (typeof fbq === 'function') {
        fbq('track', 'Lead', {
          content_name: 'Contact Lead',
          currency: 'INR',
          value: 1.00
        });
        console.log('Meta Pixel: Lead Event Recorded');
      }
    } catch(err) {
      console.warn('Pixel notice:', err);
    }

    // 3. GOOGLE ADS / ANALYTICS LEAD EVENT
    try {
      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          'event_category': 'Leads',
          'event_label': 'Website Form'
        });
        console.log('Google Tag: generate_lead Event Recorded');
      }
    } catch(err) {
      console.warn('Google Tag notice:', err);
    }
  });
</script>
