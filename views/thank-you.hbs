<!-- CONVERSION TRACKING & CLIENT-SIDE PERSONALIZATION -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Parse URL Query Parameters for Dynamic Personalization
    var params = new URLSearchParams(window.location.search);
    var name = params.get('name');
    var service = params.get('service');

    if (name && name.trim()) {
      var cleanName = decodeURIComponent(name.trim());
      var nameEl = document.getElementById('user-name');
      if (nameEl) nameEl.textContent = cleanName;
    }

    if (service && service.trim()) {
      var cleanService = decodeURIComponent(service.trim());
      var serviceEl = document.getElementById('user-service');
      if (serviceEl) serviceEl.textContent = cleanService;
    }

    // 2. Generate Unique Ticket ID
    var randomId = Math.floor(10000 + Math.random() * 90000);
    var ticketEl = document.getElementById('ticket-id');
    if (ticketEl) ticketEl.textContent = '#WU-' + randomId;

    // 3. Dynamic WhatsApp URL with lead details
    var waBtn = document.getElementById('wa-cta-btn');
    if (waBtn) {
      var waName = (name && name.trim()) ? decodeURIComponent(name.trim()) : 'Growth Partner';
      var waService = (service && service.trim()) ? decodeURIComponent(service.trim()) : 'Growth Strategy';
      var waText = '*🚀 Priority Growth Inquiry — WholeUp*\n\n' +
                   '👤 *Name:* ' + waName + '\n' +
                   '🎯 *Service:* ' + waService + '\n' +
                   '🎫 *Ticket ID:* #WU-' + randomId + '\n\n' +
                   'Hi Neel, I just completed my inquiry on wholeup.in and want to fast-track my growth audit.';
      waBtn.href = 'https://api.whatsapp.com/send?phone=919426846035&text=' + encodeURIComponent(waText);
    }

    // 4. META PIXEL: AUTOMATIC LEAD EVENT FIRING
    try {
      if (typeof fbq === 'function') {
        fbq('track', 'Lead', {
          content_name: service ? decodeURIComponent(service) : 'Growth Inquiry',
          currency: 'INR',
          value: 1.00
        });
        console.log('✅ Meta Pixel Lead Event Fired Successfully');
      } else {
        console.log('ℹ️ Meta Pixel not initialized yet on window');
      }
    } catch(err) {
      console.warn('Pixel tracking notice:', err);
    }

    // 5. GOOGLE ADS / ANALYTICS LEAD EVENT
    try {
      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          'event_category': 'Leads',
          'event_label': service ? decodeURIComponent(service) : 'Website Form'
        });
        console.log('✅ Google Tag Lead Event Fired Successfully');
      }
    } catch(err) {
      console.warn('Google Tag notice:', err);
    }
  });
</script>
